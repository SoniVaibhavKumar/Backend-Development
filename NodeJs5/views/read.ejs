<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="w-full min-h-screen bg-zinc-900 p-4 sm:p-8 md:p-10">
        <a class="text-blue-500 hover:underline" href="/">back to home</a>
        <h1 class="text-2xl sm:text-3xl mt-10 tracking-tighter mb-5">All Users</h1>
        <div class="users grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
            <% if(users.length > 0) { %>
                <% users.forEach(function(user) { %>
                    <div class="user w-full p-4 bg-zinc-800 rounded-lg flex flex-col justify-between">
                        <div>
                            <div class="w-full h-48 sm:h-64 rounded-lg bg-zinc-700 overflow-hidden">
                                <img class="w-full h-full object-cover object-center" src="<%= user.image %>" alt="">
                            </div>
                            <h3 class="text-xl mt-3 tracking-tighter truncate"><%= user.name %></h3>
                            <h5 class="text-zinc-500 text-sm truncate"><%= user.email %></h5>
                        </div>
                        <div class="flex gap-3 mt-6 pt-2 justify-between text-sm">
                            <a class="text-zinc-200 hover:text-white" href="/edit/<%= user._id %>">Edit User</a>
                            <a class="text-red-500 hover:text-red-400" href="/delete/<%= user._id %>">Delete User</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-zinc-500 col-span-full">no users yet</h3>
            <% } %> 
        </div>
    </div>
</body>
</html>